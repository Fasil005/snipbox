pipeline {
    agent any

    environment {
        APP_NAME = "snipbox"
        IMAGE_TAG = "${BUILD_NUMBER}"
    }

    stages {

        stage('Validate Files') {
            steps {
                sh '''
                test -f Dockerfile
                test -f docker-compose.yml
                test -f .env
                '''
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                docker build -t ${APP_NAME}:${IMAGE_TAG} .
                '''
            }
        }

        stage('Run Tests') {
            steps {
                sh '''
                docker run --rm \
                  --env-file .env \
                  ${APP_NAME}:${IMAGE_TAG} \
                  pytest || true
                '''
            }
        }

        stage('Smoke Test') {
            steps {
                sh '''
                docker compose up -d
                sleep 10
                docker compose ps
                docker compose down
                '''
            }
        }

        stage('Tag & Push Image') {
            when {
                branch 'main'
            }
            steps {
                sh '''
                docker tag ${APP_NAME}:${IMAGE_TAG} ${APP_NAME}:latest
                '''
            }
        }

        stage('Deploy') {
            when {
                branch 'main'
            }
            steps {
                sh '''
                docker compose down
                docker compose up -d
                '''
            }
        }
    }

    post {
        always {
            sh 'docker system prune -f || true'
        }
        success {
            echo "Pipeline successful for ${APP_NAME}"
        }
        failure {
            echo "Pipeline failed for ${APP_NAME}"
        }
    }
}
